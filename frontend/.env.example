# Vite development/preview proxy destination. Not included in the browser bundle.
ACEFIRE_BACKEND_URL=http://127.0.0.1:8000

# Browser API prefix. Keep /api when using the Vite proxy or a production reverse proxy.
# A separate absolute API origin requires allowed-origin CORS on that backend.
VITE_API_BASE_URL=/api

# Optional public contact inbox for the landing page. Opens an email draft.
# Defaults to the user-supplied public inbox hello@ingenium.ai.
# VITE_CONTACT_EMAIL=team@example.com
