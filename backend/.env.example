# Export these in your shell. Never commit the populated API key or database password.
# Optional for future live refresh. Saved Akta JSON intake needs no key.
AKTA_API_KEY=
AKTA_MCP_URL=https://mcp.akta.pro/mcp
# Documented structured JSON API; used for deterministic company enrichment.
AKTA_API_URL=https://api.akta.pro
# Local embedded DuckDB database; created automatically, no account required.
# DUCKDB_PATH=/absolute/path/to/acefire/backend/.cache/acefire.duckdb
# DATA_ROOT=/absolute/path/to/acefire/data/additional-cases
# AKTA_DATA_ROOT=/absolute/path/to/acefire/data/akta
# SOURCE_CACHE_DIR=/absolute/path/to/acefire/backend/.cache/sources

# Natural-language calculation code generation. backend/.env is read by this workflow.
NICRRON_API_KEY=
NICRRON_BASE_URL=https://api.nicrron.ai/v1
LLM_MODEL=openai/gpt-6.1-sol
# Local worker wall-clock limit, in seconds (bounded by the backend).
AGENT_EXECUTION_TIMEOUT_SECONDS=10

# Optional live Firestore storage. Read by python run_local.py, or export in shell.
# DATA_STORE=firestore
# FIREBASE_PROJECT_ID=acefire-50248
# FIRESTORE_DATABASE_ID=acefire
# GOOGLE_APPLICATION_CREDENTIALS=/private/path/to/application-default-credentials.json
# SOURCE_FILE_MANIFEST=/private/path/to/source-files.json
# ACEFIRE_PORT=8017
