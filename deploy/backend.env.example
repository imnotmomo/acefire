# Installed privately as /etc/ingenium/backend.env; never put credentials in Git.
DATA_STORE=firestore
FIREBASE_PROJECT_ID=acefire-50248
FIRESTORE_DATABASE_ID=acefire
GOOGLE_APPLICATION_CREDENTIALS=/etc/ingenium/firestore-runtime.json
SOURCE_FILE_MANIFEST=/etc/ingenium/source-files.json
NICRRON_API_KEY=
NICRRON_BASE_URL=https://api.nicrron.ai/v1
LLM_MODEL=openai/gpt-6.1-sol
AGENT_EXECUTION_TIMEOUT_SECONDS=10
